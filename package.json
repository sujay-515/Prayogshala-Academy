{
  "name": "medlab-qbank",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false --ignore 'data/**' --ignore 'test_mcqs/**' server.ts",
    "start": "tsx server.ts",
    "backup": "tsx src/server/backup.ts",
    "list-legacy-accounts": "tsx src/server/scripts/listLegacyAccounts.ts",
    "prebuild": "node scripts/check-placeholders.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "tsx --test tests/api/**/*.test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
