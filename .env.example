# OCR & Vision extraction key (optional):
GEMINI_API_KEY=""

# Resend Email Integration (Get free API key at https://resend.com):
RESEND_API_KEY=""
EMAIL_FROM="MedLab QBank <onboarding@resend.dev>"
EMAIL_VERIFICATION_REQUIRED="" # Optional ("true" or "false"). Defaults to "true" if RESEND_API_KEY is non-empty, "false" otherwise.

# Supabase Synchronization (Opt-in; requires enabled flag and service_role key):
SUPABASE_SYNC_ENABLED="" # "true" to enable cloud synchronization
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Database Backup Configuration (Optional):
