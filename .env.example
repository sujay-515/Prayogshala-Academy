# Answer Checking Rate Limits:
ANSWER_CHECK_USER_PER_HOUR="300"
ANSWER_CHECK_USER_PER_DAY="1500"
ANSWER_CHECK_GUEST_PER_HOUR="60"
ANSWER_CHECK_GUEST_PER_DAY="200"
