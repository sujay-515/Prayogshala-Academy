# Runtime Environment & Network:
NODE_ENV=""
PORT=""
DATA_DIR=""
APP_URL="http://localhost:3001"
SITE_URL=""
VITE_SITE_URL=""
TRUST_PROXY="" # Non-negative integer hop count behind reverse proxy/CDN (e.g. "1"). Do not set to "true".
CSP_MODE="" # "report-only" (default) or "enforce"
RATE_LIMIT_REGISTER_MAX=""
STRICT_PLACEHOLDERS=""

# Initial Superadmin Bootstrap (Required on fresh install; remove after initial boot):
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Development Seeding (Optional; only active when NODE_ENV=development):
SEED_DEMO_DATA=""

# OCR & Vision extraction key (optional):
GEMINI_API_KEY=""

# Google Sign-In Integration (OAuth 2.0 Web Client ID; leaving empty disables Google sign-in):
GOOGLE_CLIENT_ID="" # Server-side token audience verification
VITE_GOOGLE_CLIENT_ID="" # Frontend Google Identity Services client ID (same value)

# Resend Email Integration (Get free API key at https://resend.com):
RESEND_API_KEY=""
EMAIL_FROM="MedLab QBank <onboarding@resend.dev>"

# Supabase Synchronization (Opt-in; requires enabled flag and service_role key):
SUPABASE_SYNC_ENABLED="" # "true" to enable cloud synchronization
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Database Backup Configuration (Optional):
BACKUP_DIR=""
BACKUP_KEEP="7"
BACKUP_INTERVAL_HOURS=""

# Answer Checking Rate Limits:
ANSWER_CHECK_USER_PER_HOUR="300"
ANSWER_CHECK_USER_PER_DAY="1500"
ANSWER_CHECK_GUEST_PER_HOUR="60"
ANSWER_CHECK_GUEST_PER_DAY="200"
EXAM_START_PER_HOUR="10"
EXTRACT_PDF_PER_HOUR="20"
